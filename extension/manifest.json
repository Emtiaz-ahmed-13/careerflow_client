{
  "manifest_version": 3,
  "name": "CareerFlow - Save LinkedIn Jobs",
  "version": "1.0.1",
  "description": "Save LinkedIn job posts to CareerFlow Goal Session with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "clipboardRead"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://client-mocha-five-q1k2xjicnj.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "CareerFlow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://client-mocha-five-q1k2xjicnj.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["content-careerflow.js"],
      "run_at": "document_start"
    }
  ]
}
