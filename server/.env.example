# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Direct connection (recommended for Prisma + Supabase)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.ndzhwrbnrvsvbdmlenmz.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.ndzhwrbnrvsvbdmlenmz.supabase.co:5432/postgres"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── ImageKit (imagekit.io) ───────────────────────────────────────────────────
# Use STANDARD keys (not restricted) for server-side upload
IMAGEKIT_ID=lp7vscy0fc
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/lp7vscy0fc

# ─── AI Provider: groq | anthropic | gemini ──────────────────────────────────
AI_PROVIDER=groq

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini (fallback) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated origins (Vercel client URL after deploy)
CORS_ORIGIN=http://localhost:3000,https://your-client.vercel.app
NODE_ENV=development

# ─── Email (SMTP) — for direct send from Goal Session ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com

# ─── Cron (Vercel cron for follow-up reminders) ─────────────────────────────
CRON_SECRET=careerflow-cron-2026-secure

# ─── Client URL (used in reminder emails) ───────────────────────────────────
CLIENT_URL=https://client-mocha-five-q1k2xjicnj.vercel.app
